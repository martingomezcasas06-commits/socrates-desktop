{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Socrates",
  "version": "0.1.9",
  "identifier": "app.socrates.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Socrates",
        "width": 1120,
        "height": 700,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "socrates"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/martingomezcasas06-commits/socrates-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDOEFBMzJDQjQ1RUZCNjUKUldSbCsxNjBMS09LUEVXdWRpS2YyMms1TGgrbFo2SWkrQ0grQm9Xb1ZQbGI3SW5pa0VQVWYrT2YK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./locales/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "./locales/es.lproj/InfoPlist.strings"
      }
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
